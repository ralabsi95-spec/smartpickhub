---
import '../styles/global.css';
interface Props { title: string; description?: string; canonical?: string; socialImage?: string; }
const { title, description = 'Practical buying guides and product comparisons for shoppers in the United States and United Kingdom.', canonical, socialImage } = Astro.props;
const canonicalUrl = canonical ?? Astro.url.href;
const socialImageUrl = socialImage ? new URL(socialImage, Astro.site).toString() : undefined;
const pinterestVerifyCode = import.meta.env.PINTEREST_VERIFY_CODE?.trim() || 'd630453baec97d1224b9a2d33d955c49';
const isPreviewBuild = process.env.DEPLOYMENT_ENV === 'preview' || (Boolean(process.env.CF_PAGES_BRANCH) && process.env.CF_PAGES_BRANCH !== 'main') || Astro.site?.hostname !== 'smartpickhub.pages.dev';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content={isPreviewBuild ? "noindex, nofollow" : "index, follow, max-image-preview:large"} />
    <meta name="google-site-verification" content="zH0EHPDRo5BI_WTJ_OnnD-aDAMc8U0ZORttx4Xs4TCs" />
    {pinterestVerifyCode && <meta name="p:domain_verify" content={pinterestVerifyCode} />}
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    {socialImageUrl && <meta property="og:image" content={socialImageUrl} />}
    {socialImageUrl && <meta name="twitter:card" content="summary_large_image" />}
    {socialImageUrl && <meta name="twitter:image" content={socialImageUrl} />}
  </head>
  <body>
    <header class="site-header">
      <div class="container header-inner">
        <a class="brand" href="/">SmartPickHub</a>
        <nav aria-label="Main navigation">
          <a href="/">Home</a>
          <a href="/guides/">Buying Guides</a>
          <a href="/how-we-research/">How We Research</a>
          <a href="/rss.xml">RSS</a>
          <a href="/affiliate-disclosure/">Affiliate Disclosure</a>
        </nav>
      </div>
    </header>
    <main class="container"><slot /></main>
    <footer class="site-footer">
      <div class="container">
        <p>As an Amazon Associate I earn from qualifying purchases.</p>
        <p>SmartPickHub may earn commissions from qualifying purchases. Affiliate links are identified near the relevant links. Product details and availability can change; always confirm current details with the retailer.</p>
        <button type="button" class="cookie-preferences" id="sph-cookie-preferences">Cookie preferences</button>
      </div>
    </footer>
    <section class="cookie-banner" id="sph-cookie-banner" role="dialog" aria-labelledby="sph-cookie-title" aria-describedby="sph-cookie-description" hidden>
      <div class="cookie-banner-copy">
        <h2 id="sph-cookie-title">Your privacy choices</h2>
        <p id="sph-cookie-description">SmartPickHub would like to use Google Analytics to understand how visitors use the site and improve our buying guides. Analytics is optional and will not load unless you choose to accept it. You can change your choice at any time using Cookie preferences.</p>
      </div>
      <div class="cookie-banner-actions">
        <button type="button" class="cookie-button cookie-button-accept" id="sph-cookie-accept">Accept analytics</button>
        <button type="button" class="cookie-button cookie-button-reject" id="sph-cookie-reject">Reject analytics</button>
      </div>
    </section>
    <script is:inline>
      (() => {
        const consentKey = 'sph-analytics-consent';
        const banner = document.getElementById('sph-cookie-banner');
        const accept = document.getElementById('sph-cookie-accept');
        const reject = document.getElementById('sph-cookie-reject');
        const preferences = document.getElementById('sph-cookie-preferences');

        function loadAnalytics() {
          if (window.location.hostname !== 'smartpickhub.pages.dev' || window.__sphAnalyticsLoaded) return;
          window.__sphAnalyticsLoaded = true;
          window.dataLayer = window.dataLayer || [];
          window.gtag = function(){ window.dataLayer.push(arguments); };
          window.gtag('js', new Date());
          window.gtag('config', 'G-Q7XK4V953R');
          const script = document.createElement('script');
          script.async = true;
          script.src = 'https://www.googletagmanager.com/gtag/js?id=G-Q7XK4V953R';
          document.head.appendChild(script);
        }

        function saveChoice(choice) {
          try {
            localStorage.setItem(consentKey, choice);
          } catch (error) {
            // If storage is unavailable, do not enable analytics.
          }
          banner.hidden = true;
          if (choice === 'accepted') loadAnalytics();
        }

        let choice = null;
        try {
          choice = localStorage.getItem(consentKey);
        } catch (error) {
          choice = null;
        }

        if (choice === 'accepted') loadAnalytics();
        else if (choice !== 'rejected') banner.hidden = false;

        accept.addEventListener('click', () => saveChoice('accepted'));
        reject.addEventListener('click', () => saveChoice('rejected'));
        preferences.addEventListener('click', () => {
          banner.hidden = false;
          banner.querySelector('#sph-cookie-accept').focus();
        });
      })();
    </script>
  </body>
</html>
