---
import Layout from '../../layouts/Layout.astro';
import data from '../../data/products.json';
const guides = data.guides ?? [];
const categories = [...new Set(guides.map((guide) => guide.category).filter(Boolean))].sort((a, b) => a.localeCompare(b));
---
<Layout title="Buying Guides | SmartPickHub" description="Explore research-led buying guides for US and UK shoppers. Search by topic or narrow the library by category.">
  <section class="guide-library">
    <h1>Buying Guides</h1>
    <p class="muted">Research-led guides for US and UK shoppers. Find a topic or browse by category.</p>

    <div class="guide-filters" role="group" aria-label="Filter buying guides">
      <div class="guide-search-field">
        <label for="guide-search">Search guides</label>
        <input id="guide-search" type="search" placeholder="Try headphones, home office, printers…" autocomplete="off" />
      </div>
      <div class="guide-category-field">
        <label for="guide-category">Category</label>
        <select id="guide-category">
          <option value="">All categories</option>
          {categories.map((category) => <option value={category}>{category}</option>)}
        </select>
      </div>
    </div>

    <p id="guide-results-count" class="guide-results-count" role="status" aria-live="polite">{guides.length} guides available</p>

    {guides.length ? (
      <div class="grid guide-grid" id="guide-grid">
        {guides.map((guide) => {
          const searchText = [guide.title, guide.category, guide.summary].filter(Boolean).join(' ').toLocaleLowerCase();
          return (
            <article class="card guide-card" data-guide-card data-category={guide.category ?? ''} data-search={searchText}>
              <a class="guide-card-cover" href={`/guides/${guide.slug}/`} tabindex="-1" aria-hidden="true"><img src={`/images/webp/${guide.slug}.webp`} alt="" width="1000" height="1500" loading="lazy" decoding="async" /></a>
              <div class="guide-card-content">
                <span class="category-tag">{guide.category}</span>
                <h2><a href={`/guides/${guide.slug}/`}>{guide.title}</a></h2>
                <p class="guide-card-summary">{guide.summary}</p>
                <div class="guide-card-bottom">
                  <span class="guide-card-status">{guide.editorialStatus ?? 'Editorial review required before publication.'}</span>
                  <a class="card-arrow" href={`/guides/${guide.slug}/`}>Read guide <span aria-hidden="true">→</span></a>
                </div>
              </div>
            </article>
          );
        })}
      </div>
      <p id="guide-no-results" class="guide-no-results" hidden>No guides match your search. Try another keyword or choose “All categories”.</p>
    ) : <p>No guides are available yet.</p>}
  </section>

  <script>
    const searchInput = document.querySelector<HTMLInputElement>('#guide-search');
    const categorySelect = document.querySelector<HTMLSelectElement>('#guide-category');
    const cards = Array.from(document.querySelectorAll<HTMLElement>('[data-guide-card]'));
    const count = document.querySelector<HTMLElement>('#guide-results-count');
    const emptyState = document.querySelector<HTMLElement>('#guide-no-results');

    function filterGuides() {
      const query = searchInput?.value.trim().toLocaleLowerCase() ?? '';
      const category = categorySelect?.value ?? '';
      let visible = 0;

      for (const card of cards) {
        const matchesQuery = (card.dataset.search ?? '').includes(query);
        const matchesCategory = !category || card.dataset.category === category;
        const show = matchesQuery && matchesCategory;
        card.hidden = !show;
        if (show) visible += 1;
      }

      if (count) count.textContent = `Showing ${visible} of ${cards.length} guides`;
      if (emptyState) emptyState.hidden = visible !== 0;
    }

    searchInput?.addEventListener('input', filterGuides);
    categorySelect?.addEventListener('change', filterGuides);
  </script>
</Layout>
