---
import Layout from '../layouts/Layout.astro';
import data from '../data/products.json';
const guides = data.guides ?? [];
const guideCount = guides.length;
const featuredGuides = guides.slice(0, 6);
const productCount = guides.reduce((total, guide) => total + (guide.products?.length ?? 0), 0);
---
<Layout title="SmartPickHub – Clear Buying Guides for the US & UK" description="Make confident tech and home-buying decisions with practical, research-led product comparisons for shoppers in the United States and United Kingdom.">
  <section class="home-hero">
    <div class="hero-copy">
      <span class="eyebrow">A clearer way to choose</span>
      <h1>Buy smarter.<br /><span>Choose with confidence.</span></h1>
      <p class="hero-intro">Straightforward buying guides that help you compare features, understand trade-offs and find the right product for your needs — whether you shop in the US or UK.</p>
      <div class="hero-actions">
        <a class="button" href="/guides/">Explore buying guides</a>
        <a class="text-link" href="#our-approach">How our guides work <span aria-hidden="true">→</span></a>
      </div>
      <ul class="hero-points" aria-label="What to expect">
        <li>Clear comparisons</li>
        <li>Practical buying advice</li>
        <li>Separate US & UK store links</li>
      </ul>
    </div>
    <div class="hero-panel">
      <div class="hero-panel-top"><span class="panel-mark" aria-hidden="true">S</span><span>THE SMARTPICK APPROACH</span></div>
      <div class="panel-rule"></div>
      <p class="panel-kicker">A better buying decision starts with</p>
      <div class="panel-step"><span>01</span><div><strong>Knowing what matters</strong><small>Focus on the features that fit your needs.</small></div></div>
      <div class="panel-step"><span>02</span><div><strong>Comparing the trade-offs</strong><small>Understand strengths, limits and compatibility.</small></div></div>
      <div class="panel-step"><span>03</span><div><strong>Choosing your marketplace</strong><small>Use the store links for your own region.</small></div></div>
      <p class="panel-note">Research first. Decide with confidence.</p>
    </div>
  </section>

  <section class="stats-strip" aria-label="Site coverage">
    <div><strong>{guideCount}</strong><span>Buying guides</span></div>
    <div><strong>{productCount}</strong><span>Products compared in our research library</span></div>
    <div><strong>US + UK</strong><span>Two marketplaces considered</span></div>
  </section>

  <section class="home-section" id="guides">
    <div class="section-heading">
      <div><span class="eyebrow">A good place to start</span><h2>Featured buying guides</h2><p class="muted">A small selection from our growing library. Browse the full collection to explore all {guideCount} topics.</p></div>
      <a class="text-link" href="/guides/">Browse all {guideCount} guides <span aria-hidden="true">→</span></a>
    </div>
    {guides.length > 0 ? (
      <div class="guide-grid home-featured-grid">
        {featuredGuides.map((guide, index) => (
          <article class="guide-card home-featured-card">
            <a class="guide-card-cover" href={`/guides/${guide.slug}/`} tabindex="-1" aria-hidden="true">
              <img src={`/images/webp/${guide.slug}.webp`} alt="" width="720" height="1080" loading={index < 3 ? 'eager' : 'lazy'} decoding="async" />
            </a>
            <div class="home-featured-content">
              <div class="guide-card-top"><span class="guide-number">{String(index + 1).padStart(2, '0')}</span><span class="category-tag">{guide.category}</span></div>
              <h3><a href={`/guides/${guide.slug}/`}>{guide.title}</a></h3>
              <p>{guide.summary}</p>
              <div class="guide-card-bottom"><span class="review-status">{guide.editorialStatus ?? 'Research-led guide — verify the exact model and current retailer listing before purchase.'}</span><a class="card-arrow" href={`/guides/${guide.slug}/`}>Explore guide <span aria-hidden="true">↗</span></a></div>
            </div>
          </article>
        ))}
      </div>
    ) : (
      <div class="empty-guides"><h3>New buying guides are on the way</h3><p>We are researching practical comparisons for shoppers in both the US and UK. Guides will appear here after editorial review.</p></div>
    )}
  </section>

  <section class="approach-section" id="our-approach">
    <div class="approach-heading"><span class="eyebrow">Our approach</span><h2>Useful advice, not just another product list.</h2><p>Good buying advice explains why a feature matters, what to check before ordering and where a product may not be the right fit.</p><a class="text-link" href="/how-we-research/">Read how we research and compare products →</a></div>
    <div class="approach-grid">
      <article><span class="approach-icon" aria-hidden="true">⌕</span><h3>Research the details</h3><p>We use product and manufacturer information to explain specifications and compatibility considerations.</p></article>
      <article><span class="approach-icon" aria-hidden="true">⇄</span><h3>Make comparisons clearer</h3><p>We highlight meaningful differences and trade-offs so you can match products to your own priorities.</p></article>
      <article><span class="approach-icon" aria-hidden="true">◎</span><h3>Shop in your region</h3><p>Guides provide separate Amazon US and Amazon UK destinations where available. Always confirm the exact model and current listing.</p></article>
    </div>
  </section>

  <section class="home-disclosure">
    <div><span class="eyebrow">A note on affiliate links</span><h2>Our recommendations should help you decide.</h2><p>Some links may earn SmartPickHub a commission at no extra cost to you. This does not replace checking the product details, compatibility and current price on the retailer's website.</p></div>
    <a class="button secondary" href="/affiliate-disclosure/">Read our disclosure</a>
  </section>
</Layout>
