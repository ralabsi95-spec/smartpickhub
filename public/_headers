# Cloudflare Pages static asset caching.
# Hashed Astro bundles are content-addressed and safe to cache for a year.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Editorial covers keep a short freshness window because their content can be regenerated.
/images/webp/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/images/pinterest/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/favicon.svg
  Cache-Control: public, max-age=86400
